---
// ARA — Landing P01. Estática, sin JS de cliente. Destino: Cloudflare Pages.
// Dependencias: astro, tailwindcss, @tailwindcss/vite, @fontsource-variable/schibsted-grotesk
import "../styles/global.css";
import "@fontsource-variable/schibsted-grotesk";

const site = {
  name: "ARA",
  full: "Adaptive Resolution Architecture",
  tagline: "Custom Agents · Intelligent Automation · Engineered Solutions",
  email: "contacto@ara.example", // TODO: dominio definitivo
};

const principles = [
  ["Resolución adaptativa", "El nivel de detalle se fija según el problema: se especifica con precisión donde el riesgo lo exige y no más."],
  ["Modularidad", "Cada componente tiene una interfaz definida y puede sustituirse sin reescribir el sistema."],
  ["Fallo explícito", "Los errores se detectan, se registran y se resuelven por diseño. Nada falla en silencio."],
  ["Sin relleno", "Entregables medibles, documentación operativa y alcance acotado."],
];

const pillars = [
  {
    title: "Agentes a medida",
    lead: "Agentes de software con alcance, herramientas y permisos definidos para un caso de uso concreto.",
    items: ["Contrato de herramientas y límites de autonomía", "Evaluaciones reproducibles antes de producción", "Trazabilidad de cada decisión y acción"],
  },
  {
    title: "Automatización resiliente",
    lead: "Procesos operativos que toleran fallos de terceros y degradan de forma controlada.",
    items: ["Reintentos idempotentes, colas y control de duplicados", "Observabilidad: métricas, logs y alertas accionables", "Escalado a revisión humana cuando la confianza es baja"],
  },
  {
    title: "Ingeniería de soluciones",
    lead: "Integración con los sistemas que ya operan: APIs, bases de datos, ERP y software heredado.",
    items: ["Arquitectura y decisiones documentadas", "Despliegue reproducible y entornos separados", "Traspaso con runbooks y código bajo su control"],
  },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ARA — Adaptive Resolution Architecture</title>
    <meta name="description" content="ARA diseña y despliega agentes de software, automatización de procesos e integraciones con sistemas reales." />
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="antialiased">
    <a href="#contacto" class="sr-only focus:not-sr-only focus:absolute focus:m-4 focus:bg-panel focus:p-2">Ir al contacto</a>

    <header class="mx-auto flex max-w-6xl items-baseline justify-between px-6 py-6">
      <span class="text-lg font-semibold tracking-tight">{site.name}</span>
      <nav class="flex gap-6 text-sm text-muted" aria-label="Principal">
        <a class="hover:text-text" href="#servicios">Servicios</a>
        <a class="hover:text-text" href="#principios">Principios</a>
        <a class="hover:text-text" href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-24 pt-16 md:grid-cols-[1.3fr_1fr] md:pt-24">
        <div>
          <h1 class="max-w-[18ch] text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl md:text-6xl">
            Software que opera dentro de sistemas reales.
          </h1>
          <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-muted">
            {site.name} ({site.full}) diseña y despliega soluciones a medida: agentes de software,
            automatización de procesos e integración con la infraestructura existente. Cada entrega
            se especifica, se prueba y se opera como infraestructura, no como demostración.
          </p>
          <p class="mt-6 text-sm text-muted">{site.tagline}</p>
          <a href="#contacto" class="mt-10 inline-block bg-signal px-5 py-3 text-sm font-semibold text-ink hover:brightness-110">
            Solicitar evaluación técnica
          </a>
        </div>

        <!-- Malla adaptativa: el refinamiento converge donde el problema lo exige. -->
        <figure class="mx-auto w-full max-w-sm">
          <svg viewBox="0 0 320 320" role="img" aria-labelledby="mesh-t" fill="none" stroke="currentColor" stroke-width="1" class="text-line">
            <title id="mesh-t">Malla cuadrada que se subdivide progresivamente hacia la esquina inferior derecha</title>
            <rect x="0.5" y="0.5" width="319" height="319" />
            <path class="lv" style="--d:.1s" d="M160 0V320M0 160H320" />
            <path class="lv" style="--d:.5s" d="M240 0V160M160 80H320M80 160V320M0 240H160M240 160V320M160 240H320" />
            <path class="lv" style="--d:.9s" d="M200 160V240M160 200H240M280 240V320M240 280H320" />
            <path class="lv" style="--d:1.3s" stroke="#93a3aa" d="M300 280V320M280 300H320" />
            <path class="lv" style="--d:1.7s" stroke="#6aa7ff" d="M310 300V320M300 310H320" />
            <rect class="lv" style="--d:2.1s" x="310" y="310" width="10" height="10" fill="#6aa7ff" stroke="none" />
          </svg>
          <figcaption class="mt-3 text-sm text-muted">Mayor resolución solo donde el problema la exige.</figcaption>
        </figure>
      </section>

      <!-- SERVICIOS -->
      <section id="servicios" class="border-t border-line">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <h2 class="max-w-[30ch] text-2xl font-semibold tracking-tight sm:text-3xl">Tres líneas de trabajo, un mismo estándar de ingeniería.</h2>
          <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
            {pillars.map((p) => (
              <article class="border-l border-line pl-6">
                <h3 class="text-xl font-semibold">{p.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{p.lead}</p>
                <ul class="mt-6 space-y-3 text-sm leading-relaxed">
                  {p.items.map((i) => <li class="border-t border-line pt-3">{i}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- PRINCIPIOS -->
      <section id="principios" class="border-t border-line bg-panel">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-[1fr_2fr]">
          <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Cómo se construye.</h2>
          <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
            {principles.map(([t, d]) => (
              <div>
                <dt class="font-semibold">{t}</dt>
                <dd class="mt-2 leading-relaxed text-muted">{d}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="border-t border-line">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-[1fr_1.2fr]">
          <div>
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Solicitud técnica</h2>
            <p class="mt-4 max-w-[46ch] leading-relaxed text-muted">
              Describa el proceso o sistema, las integraciones implicadas y las restricciones
              (volumen, latencia, cumplimiento). Responderemos con una evaluación de viabilidad y alcance.
            </p>
            <p class="mt-6 text-sm text-muted">También por correo: <a class="text-text underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>

          <!-- Endpoint por definir: Pages Function (/api/contact) o servicio de formularios. -->
          <form action="/api/contact" method="post" class="space-y-5">
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div>
              <label for="nombre" class="block text-sm text-muted">Nombre y organización</label>
              <input id="nombre" name="nombre" required class="mt-1 w-full border border-line bg-ink px-3 py-2" />
            </div>
            <div>
              <label for="email" class="block text-sm text-muted">Correo</label>
              <input id="email" name="email" type="email" required class="mt-1 w-full border border-line bg-ink px-3 py-2" />
            </div>
            <div>
              <label for="contexto" class="block text-sm text-muted">Sistema, proceso y restricciones</label>
              <textarea id="contexto" name="contexto" rows="6" required class="mt-1 w-full border border-line bg-ink px-3 py-2"></textarea>
            </div>
            <button type="submit" class="bg-signal px-5 py-3 text-sm font-semibold text-ink hover:brightness-110">Enviar solicitud técnica</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl justify-between px-6 py-8 text-sm text-muted">
        <span>{site.name} — {site.full}</span>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
